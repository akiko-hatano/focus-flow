{
  "name": "focusflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "playwright install chromium",
    "browser-use:todo": "tsx --env-file .env.local browser-use/todo-crud.ts",
    "browser-use:profile": "tsx --env-file .env.local browser-use/profile.ts",
    "browser-use:settings": "tsx --env-file .env.local browser-use/settings.ts"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "jotai": "2.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "browser-use": "^0.7.3",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.9",
    "jsdom": "29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
